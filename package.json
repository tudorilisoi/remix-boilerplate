{
  "name": "remix-boilerplate",
  "private": true,
  "sideEffects": false,
  "type": "module",
  "scripts": {
    "build": "rm -rf build 2>&1; remix vite:build",
    "dev": "remix vite:dev",
    "lint": "eslint --ignore-path .gitignore --cache --cache-location ./node_modules/.cache/eslint .",
    "start": "remix-serve ./build/server/index.js",
    "zen": "zenstack generate && dotenv -- prisma db push",
    "typecheck": "tsc"
  },
  "dependencies": {
    "@clerk/localizations": "2.8.1",
    "@clerk/remix": "4.2.22",
    "@conform-to/react": "^1.1.5",
    "@conform-to/zod": "^1.1.5",
    "@prisma/client": "^5.19.1",
    "@remix-run/node": "^2.12.0",
    "@remix-run/react": "^2.12.0",
    "@remix-run/serve": "^2.12.0",
    "@tailwindcss/typography": "^0.5.15",
    "@zenstackhq/runtime": "2.5.1",
    "daisyui": "^4.12.10",
    "isbot": "^5.1.17",
    "qrcode": "^1.5.4",
    "qrcode.react": "^4.0.1",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "remix-utils": "^7.6.0"
  },
  "overrides": {
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@remix-run/dev": "^2.12.0",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@typescript-eslint/eslint-plugin": "^8.5.0",
    "@typescript-eslint/parser": "^8.5.0",
    "autoprefixer": "^10.4.20",
    "dotenv-cli": "^7.4.2",
    "eslint": "^8.57.0",
    "eslint-import-resolver-typescript": "^3.6.3",
    "eslint-plugin-import": "^2.30.0",
    "eslint-plugin-jsx-a11y": "^6.10.0",
    "eslint-plugin-react": "^7.35.2",
    "eslint-plugin-react-hooks": "^4.6.2",
    "hygen": "^6.2.11",
    "prisma": "^5.19.1",
    "rimraf": "^6.0.1",
    "tailwindcss": "^3.4.10",
    "tsup": "^8.2.4",
    "typescript": "^5.6.2",
    "vite": "^5.4.3",
    "vite-tsconfig-paths": "^5.0.1",
    "zenstack": "2.5.1"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
